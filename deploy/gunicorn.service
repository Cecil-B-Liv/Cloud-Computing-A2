# systemd unit that runs the Flask app under gunicorn.
# Install to: /etc/systemd/system/music.service
[Unit]
Description=Gunicorn instance serving the music subscription app
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/music-app
# gunicorn from the project's virtualenv; app:app = app.py, Flask object named "app"
ExecStart=/home/ubuntu/music-app/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
